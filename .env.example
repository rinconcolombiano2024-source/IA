APP_AUTH_USER=admin
APP_AUTH_PASSWORD=cambia-esta-clave-por-una-clave-larga-y-segura

OPENAI_API_KEY=pon-tu-clave-aqui
OPENAI_TEXT_MODEL=gpt-5.5
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_VIDEO_MODEL=sora-2

OPENAI_REASONING_EFFORT=medium
OPENAI_ROUTER_REASONING=low

OPENAI_IMAGE_SIZE=1024x1024
OPENAI_IMAGE_QUALITY=medium

OPENAI_VIDEO_SIZE=1280x720
OPENAI_VIDEO_SECONDS=4

OPENAI_TIMEOUT_MS=120000

# Presupuesto temporal de cada solicitud de IA
AI_REQUEST_DEADLINE_MS=280000
AI_RESPONSE_RESERVE_MS=2000
OPENAI_MAX_RETRIES=2
REQUEST_LIMIT_BYTES=2000000

# Proteccion de consumo y concurrencia de IA
AI_RUN_RATE_WINDOW_MS=60000
AI_RUN_RATE_MAX=12
AI_MAX_CONCURRENT_RUNS=2
AI_MAX_PROMPT_CHARS=30000

# Persistencia de historial/memoria operativa
AI_STATE_STORE=auto
AI_STATE_NAMESPACE=default
AI_STATE_TIMEOUT_MS=5000
AI_SUPABASE_URL=
AI_SUPABASE_SECRET_KEY=
AI_SUPABASE_STATE_TABLE=ai_state_events

PORT=3000
